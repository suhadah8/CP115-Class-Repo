<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="lab-test-1"/>
        <attribute name="authors" value="User"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-22 11:20:45 AM"/>
        <attribute name="created" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0yMjsxMTowMjozNiBBTTsyNzM0"/>
        <attribute name="edited" value="VXNlcjtERVNLVE9QLUozOVAxTlQ7MjAyNi0wNy0yMjsxMToyMDo0NSBBTTs1OzI4NDY="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="weight" type="Integer" array="False" size=""/>
            <declare name="charge" type="Real" array="False" size=""/>
            <declare name="totalCharge" type="Real" array="False" size=""/>
            <input variable="weight"/>
            <if expression="weight &gt;= 5">
                <then>
                    <assign variable="charge" expression="(5*8)+((weight-5)*6)"/>
                    <if expression="charge&gt;60">
                        <then>
                            <assign variable="totalCharge" expression="charge+10"/>
                        </then>
                        <else>
                            <assign variable="totalCharge" expression="charge"/>
                        </else>
                    </if>
                </then>
                <else>
                    <assign variable="totalCharge" expression="(weight*8)"/>
                </else>
            </if>
            <output expression="weight" newline="True"/>
            <output expression="totalCharge" newline="True"/>
        </body>
    </function>
</flowgorithm>
